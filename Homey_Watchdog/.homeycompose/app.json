{
  "id": "com.oberbaer.homeywatchdog",
  "version": "0.7.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Dr. Wau 🐶🔧⚙️👀",
    "de": "Dr. Wau 🐶🔧⚙️👀"
  },
  "description": {
    "en": "Homey health checks, battery alerts and backups.",
    "de": "Homey-Gesundheitschecks, Batteriewarnungen und Backups."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#0B6B5F",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Oberbaer"
  },
  "api": {
    "getReport": {
      "method": "get",
      "path": "/report",
      "public": false,
      "role": "owner"
    },
    "runScan": {
      "method": "post",
      "path": "/scan",
      "public": false,
      "role": "owner"
    },
    "updateFinding": {
      "method": "post",
      "path": "/finding",
      "public": false,
      "role": "owner"
    },
    "getWatchdog": {
      "method": "get",
      "path": "/watchdog",
      "public": false,
      "role": "owner"
    },
    "updateWatchdog": {
      "method": "post",
      "path": "/watchdog",
      "public": false,
      "role": "owner"
    },
    "runWatchdog": {
      "method": "post",
      "path": "/watchdog/run",
      "public": false,
      "role": "owner"
    },
    "previewWatchdog": {
      "method": "GET",
      "path": "/watchdog/preview",
      "public": false,
      "role": "owner"
    },
    "setVacation": {
      "method": "post",
      "path": "/watchdog/vacation",
      "public": false,
      "role": "owner"
    },
    "updateDeviceProfile": {
      "method": "post",
      "path": "/watchdog/profile",
      "public": false,
      "role": "owner"
    },
    "testWatchdogNotification": {
      "method": "post",
      "path": "/watchdog/test",
      "public": false,
      "role": "owner"
    },
    "importAutomationHealth": {
      "method": "post",
      "path": "/migration/automation-health",
      "public": false,
      "role": "owner"
    },
    "getAppInfo": {
      "method": "GET",
      "path": "/app-info",
      "public": false,
      "role": "owner"
    },
    "exportBackup": {
      "method": "GET",
      "path": "/export",
      "public": false,
      "role": "owner"
    },
    "getWebdav": {
      "method": "GET",
      "path": "/webdav",
      "public": false,
      "role": "owner"
    },
    "saveWebdav": {
      "method": "POST",
      "path": "/webdav",
      "body": {
        "config": "string"
      },
      "public": false,
      "role": "owner"
    },
    "testWebdav": {
      "method": "POST",
      "path": "/webdav/test",
      "body": {
        "targetId": "string"
      },
      "public": false,
      "role": "owner"
    },
    "uploadWebdav": {
      "method": "POST",
      "path": "/webdav/upload",
      "body": {
        "targetId": "string"
      },
      "public": false,
      "role": "owner"
    },
    "getSchedule": {
      "method": "GET",
      "path": "/schedule",
      "public": false,
      "role": "owner"
    },
    "saveSchedule": {
      "method": "POST",
      "path": "/schedule",
      "body": {
        "config": "object"
      },
      "public": false,
      "role": "owner"
    },
    "runScheduleNow": {
      "method": "POST",
      "path": "/schedule/run",
      "body": {
        "targetId": "string"
      },
      "public": false,
      "role": "owner"
    },
    "restorePlan": {
      "method": "POST",
      "path": "/restore/plan",
      "body": {
        "backup": "object"
      },
      "public": false,
      "role": "owner"
    },
    "restoreRun": {
      "method": "POST",
      "path": "/restore/run",
      "body": {
        "backup": "object",
        "confirm": "boolean",
        "selection": "object"
      },
      "public": false,
      "role": "owner"
    },
    "getRestoreAuth": {
      "method": "GET",
      "path": "/restore/auth",
      "public": false,
      "role": "owner"
    },
    "saveRestoreAuth": {
      "method": "POST",
      "path": "/restore/auth",
      "body": {
        "token": "string"
      },
      "public": false,
      "role": "owner"
    },
    "testRestoreAuth": {
      "method": "POST",
      "path": "/restore/auth/test",
      "public": false,
      "role": "owner"
    },
    "saveLanguage": {
      "method": "POST",
      "path": "/language",
      "body": {
        "language": "string"
      },
      "public": false,
      "role": "owner"
    },
    "notificationUsers": {
      "method": "GET",
      "path": "/notification-users",
      "public": false,
      "role": "owner"
    },
    "startTransfer": {
      "method": "POST",
      "path": "/transfer/start",
      "body": {
        "bytes": "number",
        "kind": "string"
      },
      "public": false,
      "role": "owner"
    },
    "appendTransfer": {
      "method": "POST",
      "path": "/transfer/append",
      "body": {
        "id": "string",
        "offset": "number",
        "data": "string"
      },
      "public": false,
      "role": "owner"
    },
    "finishTransfer": {
      "method": "POST",
      "path": "/transfer/finish",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "readTransfer": {
      "method": "POST",
      "path": "/transfer/read",
      "body": {
        "id": "string",
        "offset": "number"
      },
      "public": false,
      "role": "owner"
    },
    "releaseTransfer": {
      "method": "POST",
      "path": "/transfer/release",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "prepareExport": {
      "method": "POST",
      "path": "/export/prepare",
      "public": false,
      "role": "owner"
    },
    "stagedRestorePlan": {
      "method": "POST",
      "path": "/restore/staged-plan",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "stagedRestoreRun": {
      "method": "POST",
      "path": "/restore/staged-run",
      "body": {
        "id": "string",
        "confirm": "boolean",
        "selectionId": "string"
      },
      "public": false,
      "role": "owner"
    },
    "getJob": {
      "method": "POST",
      "path": "/job",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "releaseJob": {
      "method": "POST",
      "path": "/job/release",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "getNetwork": {
      "method": "GET",
      "path": "/network",
      "public": false,
      "role": "owner"
    },
    "saveNetwork": {
      "method": "POST",
      "path": "/network",
      "body": {
        "target": "object"
      },
      "public": false,
      "role": "owner"
    },
    "removeNetwork": {
      "method": "POST",
      "path": "/network/remove",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "testNetwork": {
      "method": "POST",
      "path": "/network/test",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    },
    "backupNetwork": {
      "method": "POST",
      "path": "/network/backup",
      "body": {
        "id": "string"
      },
      "public": false,
      "role": "owner"
    }
  }
}
